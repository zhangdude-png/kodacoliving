# Public site URL used for canonical links, sitemap, and Open Graph.
# On Vercel, set this to the production origin (https://your-domain).
NEXT_PUBLIC_SITE_URL=http://localhost:4317

# Placeholder until a real WhatsApp number exists.
# Example: https://wa.me/6591234567
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/6500000000

# Supabase. Leave blank to run on local demo seed data.
# The app does not call Supabase until these are wired in a later pass.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Leave blank. Per-room subscriptions are not charged in this build.
# Create a price per room for Basic annual, Basic monthly, and Premium
# once the Premium rate (TBD, default S$30) is chosen. Subscription quantity
# should equal the operator's active room count.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_VIEWING_CREDIT=
